# ─────────────────────────────────────────────────────────────────────────────
# Admin dashboard (apps/frontend)
#
#   cp .env.example .env
#
# Vite inlines these at startup, so RESTART the dev server after any change —
# editing .env while it is running has no effect.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the commerce engine (apps/backend).
#
# Host only — do NOT include a trailing slash or the /api prefix. The server
# functions in src/server/*.ts already prepend /api to every path.
#
# This MUST be absolute. Those server functions run in Node, where fetch()
# rejects relative URLs with:
#   "Failed to parse URL from /api/auth/admin/register"
# If you see that error, this variable is unset or empty.
VITE_API_URL=http://localhost:4000
