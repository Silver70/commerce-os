# ─────────────────────────────────────────────────────────────────────────────
# Storefront (apps/storefront)
#
#   cp .env.example .env
#
# Restart the dev server after any change — Vite reads these at startup.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the commerce engine (apps/backend). Host only, no trailing slash.
# The GraphQL client appends /graphql itself (src/lib/gql-client.ts).
COMMERCE_API_URL=http://localhost:4000

# Storefront API key for the store you want this storefront to serve. It scopes
# every GraphQL request to one organization and store, and is sent as the
# `x-api-key` header.
#
# To create one, log into the admin dashboard and open
#   Settings -> API Keys
# or call the API directly with an admin token:
#   POST /api/admin/stores/{storeId}/api-keys
#
# The raw key is shown ONCE at creation and only its hash is stored — copy it
# immediately. If you lose it, generate a new one.
#
# Note this is a SERVER-side variable (no VITE_ prefix), so it is never exposed
# to the browser. Keep it that way — do not rename it to VITE_COMMERCE_API_KEY.
COMMERCE_API_KEY=

# Stripe publishable key for the checkout form — bring your own.
# From https://dashboard.stripe.com/test/apikeys, the "Publishable key"
# (starts with pk_test_). Safe to expose to the browser, unlike the secret key.
# Leave empty and checkout renders a "Payments aren't configured" notice
# instead of the payment form; the rest of the storefront works fine.
VITE_STRIPE_PUBLISHABLE_KEY=
