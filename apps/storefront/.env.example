# ─── Commerce backend (server-only — never exposed to the browser) ───────────
# Base URL of the Commerce OS GraphQL backend, without the /graphql suffix.
COMMERCE_API_URL=http://localhost:4000
# Storefront X-API-Key for this store. Create one in the admin:
# Settings → API Keys (POST /admin/stores/:id/api-keys). Shown once — copy it.
COMMERCE_API_KEY=

# ─── Stripe (browser-safe publishable key only) ──────────────────────────────
# One storefront deploy = one store for v1. The publishable key is safe to ship
# to the browser; the secret key lives only in the backend.
VITE_STRIPE_PUBLISHABLE_KEY=
