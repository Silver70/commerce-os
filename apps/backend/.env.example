# ─────────────────────────────────────────────────────────────────────────────
# Commerce engine (apps/backend)
#
# Copy to `.env` and fill in. Every value below is validated at startup by
# src/config/configuration.ts — the process refuses to boot if one is missing
# or malformed, so you get a clear error instead of a runtime surprise.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ─── Database (required) ─────────────────────────────────────────────────────
# Local PostgreSQL 13+. Do NOT append `?sslmode=require` for a local server —
# stock Postgres has no TLS and the connection will fail.
#
# Create the database first:
#   createdb commerce_os
#   -- or --  psql -U postgres -c "CREATE DATABASE commerce_os;"
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/commerce_os

# Optional. Used only by the migration and seed scripts. Set this when your
# DATABASE_URL points at a connection pooler that cannot run DDL; otherwise
# leave it commented out and the scripts fall back to DATABASE_URL.
# DIRECT_DATABASE_URL=

# ─── JWT secrets (required, 64+ characters each) ─────────────────────────────
# These sign admin dashboard and storefront customer sessions. Generate real
# random values — never reuse the placeholders, and never share one between the
# two. Generate with:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Rotating either secret invalidates all existing sessions of that type.
ADMIN_JWT_SECRET=replace_me_with_64_plus_random_characters
CUSTOMER_JWT_SECRET=replace_me_with_64_plus_random_characters

# ─── URLs ────────────────────────────────────────────────────────────────────
# Where the admin dashboard runs. Used to build set-password links emailed to
# customers an admin creates.
STOREFRONT_URL=http://localhost:3000

# Comma-separated allowed origins. Leave empty to allow all (dev only).
# Include the admin dashboard and the storefront.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Stripe (required to boot — bring your own keys) ─────────────────────────
# The app validates these as present but does not verify them, so the
# placeholders below let you boot and use everything EXCEPT payments.
# Checkout will fail until you supply real test keys.
#
# Get them from https://dashboard.stripe.com/test/apikeys (Test mode):
#   STRIPE_SECRET_KEY     -> "Secret key", starts with sk_test_
#   STRIPE_WEBHOOK_SECRET -> from `stripe listen`, starts with whsec_
#
# For webhooks locally, install the Stripe CLI and run:
#   stripe listen --forward-to localhost:4000/api/webhooks/stripe
# It prints the signing secret to paste below.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ─── Object storage — Cloudflare R2 (required to boot — bring your own) ──────
# Product media uploads go here. As with Stripe, the placeholders let the app
# boot; image upload will fail with a TLS handshake error until these are real,
# because the endpoint is built as https://{ACCOUNT_ID}.r2.cloudflarestorage.com
# and a fake account id resolves to a hostname that does not exist.
#
# From the Cloudflare dashboard -> R2:
#   STORAGE_ACCOUNT_ID        Account ID (right-hand sidebar of the R2 page)
#   STORAGE_BUCKET            your bucket name
#   STORAGE_ACCESS_KEY_ID     R2 API token -> Access Key ID
#   STORAGE_SECRET_ACCESS_KEY R2 API token -> Secret Access Key
#   STORAGE_PUBLIC_URL        the bucket's public r2.dev URL or custom domain
#
# Any S3-compatible provider works only if you also make the endpoint
# configurable in src/shared/storage/r2-storage.service.ts — it is currently
# hardcoded to Cloudflare R2.
STORAGE_ACCOUNT_ID=placeholder
STORAGE_BUCKET=placeholder
STORAGE_ACCESS_KEY_ID=placeholder
STORAGE_SECRET_ACCESS_KEY=placeholder
STORAGE_PUBLIC_URL=https://placeholder.r2.dev

# ─── Analytics ───────────────────────────────────────────────────────────────
# Days of raw analytics_events to keep before the nightly purge. Daily rollups
# are permanent regardless. Set to 0 to disable purging entirely.
ANALYTICS_RETENTION_DAYS=90

# ─── Seed script options (optional) ──────────────────────────────────────────
# Target a specific store when seeding; defaults to the first store found.
# SEED_STORE_ID=

# Used by `npm run db:seed-admin` to create or reset an admin user.
# ADMIN_EMAIL=owner@acme.com
# ADMIN_PASSWORD=changeme123
# ADMIN_NAME=Store Owner
# SEED_ORG_ID=
